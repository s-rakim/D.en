# Copy to .env and edit. Everything here is optional; defaults are sensible.

# --- Tuner -------------------------------------------------------------------
# Interface that faces the internet. "auto" uses whatever the default route uses.
WAN_IFACE=auto
TS_IFACE=tailscale0
# How often (seconds) to re-check and re-apply, in case something resets it.
REAPPLY_INTERVAL=300
ENABLE_BBR=true
ENABLE_UDP_GRO_FORWARDING=true
ENABLE_MSS_CLAMP=true
ENABLE_RPS=true
# performance = lowest latency. Use "ondemand" if heat or power matters more,
# or "none" to leave it alone.
CPU_GOVERNOR=performance
DISABLE_WIFI_POWERSAVE=true
# Leave empty to keep the kernel default.
TXQUEUELEN=
# auto, iptables-nft or iptables-legacy
IPTABLES=auto

# --- Tailscale (only with --profile tailscale) --------------------------------
# One-time auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=pi-exit
TS_PORT=41641
# Anything extra for `tailscale up`, e.g. --advertise-routes=192.168.1.0/24
TS_EXTRA_ARGS=

# --- Monitor (only with --profile monitor) ------------------------------------
PING_TARGETS=1.1.1.1 8.8.8.8
PING_INTERVAL=60
# Seconds between speed tests. Each one burns a few hundred MB. 0 = off.
SPEEDTEST_INTERVAL=21600
